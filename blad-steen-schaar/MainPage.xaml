<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="blad_steen_schaar.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="25"
            VerticalOptions="Center"
            HorizontalOptions="Center">

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="20">

                <Image
                    x:Name="speler"
                    Source="vraagteken.png"
                    HeightRequest="150"
                    WidthRequest="150"
                    Aspect="AspectFit"/>

                <Image
                    x:Name="botnetmove"
                    Source="dotnet_bot.png"
                    HeightRequest="150"
                    WidthRequest="150"
                    Aspect="AspectFit"/>

            </HorizontalStackLayout>

            <VerticalStackLayout
                HorizontalOptions="Center"
                Spacing="5">

                <RadioButton
                    Content="Blad"
                    GroupName="Keuze"
                    CheckedChanged="RadioButton_CheckedChanged"/>

                <RadioButton
                    Content="Steen"
                    GroupName="Keuze"
                    CheckedChanged="RadioButton_CheckedChanged"/>

                <RadioButton
                    Content="Schaar"
                    GroupName="Keuze"
                    CheckedChanged="RadioButton_CheckedChanged"/>

            </VerticalStackLayout>

            <Button
                x:Name="speel"
                Text="Speel!"
                Clicked="Speel_Clicked"
                HorizontalOptions="Center"
                WidthRequest="180"/>

            <Label
                x:Name="resultaat"
                Text="Maak je keuze!"
                FontSize="24"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
